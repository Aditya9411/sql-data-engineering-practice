-- Question 79: Calculate the difference between the current row's
-- salary and the previous row's salary using LAG().
-- Compatible with PostgreSQL, MySQL 8+, SQL Server, and SQLite 3.25+.

DROP TABLE IF EXISTS employees;

CREATE TABLE employees (
    id INT PRIMARY KEY,
    name VARCHAR(50) NOT NULL,
    salary INT NOT NULL
);

INSERT INTO employees (id, name, salary) VALUES
(1, 'Rahul', 50000),
(2, 'Priya', 65000),
(3, 'Aman', 60000),
(4, 'Neha', 80000),
(5, 'Rohit', 75000),
(6, 'Sneha', 90000);

-- Answer
SELECT
    name,
    salary,
    salary - LAG(salary) OVER (ORDER BY id) AS salary_diff
FROM employees
ORDER BY id;
