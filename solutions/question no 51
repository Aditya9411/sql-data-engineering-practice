-- Problem Statement:
-- Find the fifth highest salary without using
-- TOP or LIMIT.
-- Duplicate salary records should not be removed.
-- Use DENSE_RANK() to rank distinct salary values.


-- =====================================================
-- STEP 1: CREATE TABLE
-- =====================================================

DROP TABLE IF EXISTS com_worker;

CREATE TABLE com_worker (
    worker_id BIGINT PRIMARY KEY,
    department VARCHAR(25),
    first_name VARCHAR(25),
    last_name VARCHAR(25),
    joining_date DATE,
    salary BIGINT
);


-- =====================================================
-- STEP 2: INSERT SAMPLE DATA
-- =====================================================

INSERT INTO com_worker
(worker_id, department, first_name, last_name,
 joining_date, salary)
VALUES
(1, 'HR', 'John', 'Doe', '2020-01-15', 50000),
(2, 'IT', 'Jane', 'Smith', '2019-03-10', 60000),
(3, 'Finance', 'Emily', 'Jones', '2021-06-20', 75000),
(4, 'Sales', 'Michael', 'Brown', '2018-09-05', 60000),
(5, 'Marketing', 'Chris', 'Johnson', '2022-04-12', 70000),
(6, 'IT', 'David', 'Wilson', '2020-11-01', 80000),
(7, 'Finance', 'Sarah', 'Taylor', '2017-05-25', 45000),
(8, 'HR', 'James', 'Anderson', '2023-01-09', 65000),
(9, 'Sales', 'Anna', 'Thomas', '2020-02-18', 55000),
(10, 'Marketing', 'Robert', 'Jackson', '2021-07-14', 60000);


-- =====================================================
-- STEP 3: VIEW DATA
-- =====================================================

SELECT *
FROM com_worker;


-- =====================================================
-- STEP 4: SOLUTION USING CTE AND DENSE_RANK()
-- =====================================================

WITH cte AS (
    SELECT
        salary,
        DENSE_RANK() OVER (
            ORDER BY salary DESC
        ) AS rn
    FROM com_worker
)
SELECT salary
FROM cte
WHERE rn = 5;


-- =====================================================
-- STEP 5: OPTIONAL - RETURN ONE SALARY VALUE
-- =====================================================

WITH ranked_salary AS (
    SELECT
        salary,
        DENSE_RANK() OVER (
            ORDER BY salary DESC
        ) AS rn
    FROM com_worker
)
SELECT DISTINCT salary
FROM ranked_salary
WHERE rn = 5;

