/*
PROBLEM STATEMENT
-----------------
Calculate the average net earnings per order,
grouped by weekday and hour of the day based on
customer_placed_order_datetime.

Requirements:
1. Display weekday names (Monday, Tuesday, etc.).
2. Extract the hour of the order (0-23).
3. Calculate net earnings using:

   Net Earnings = Order Total + Tip Amount
                  - Discount Amount - Refunded Amount

4. Calculate average net earnings per order.
5. Round the average to 2 decimal places.
6. Sort by weekday (Monday to Sunday), then hour.
*/

-- ============================================================
-- STEP 1: CREATE TABLE
-- ============================================================

DROP TABLE IF EXISTS doordash_delivery;

CREATE TABLE doordash_delivery (
    consumer_id BIGINT,
    customer_placed_order_datetime TIMESTAMP,
    delivered_to_consumer_datetime TIMESTAMP,
    delivery_region VARCHAR(255),
    discount_amount NUMERIC(10,2),
    driver_at_restaurant_datetime TIMESTAMP,
    driver_id INT,
    is_asap INT,
    is_new INT,
    order_total NUMERIC(10,2),
    placed_order_with_restaurant_datetime TIMESTAMP,
    refunded_amount NUMERIC(10,2),
    restaurant_id BIGINT,
    tip_amount NUMERIC(10,2)
);

